{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/footer/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|disabled|type|as|href|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick, disabled, type, as, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfigChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|priceDelta|thumbnail|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ConfigChip> doesn't accept that prop. Declared props: label, detail, priceDelta, thumbnail, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: heading, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|onSearch|onBag|style|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: brand, links, onSearch, onBag, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|ariaLabel|disabled|size|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, onClick, ariaLabel, disabled, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|headline|tagline|primaryCta|secondaryCta|onPrimary|onSecondary|image|imageAlt|backgroundImage|children|style|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: tone, eyebrow, headline, tagline, primaryCta, secondaryCta, onPrimary, onSecondary, image, imageAlt, backgroundImage, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|defaultValue|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, value, defaultValue, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|price|cta|onCta|fixed|style|key|ref|className|style|children)$/]",
        "message": "<StickyBar> doesn't accept that prop. Declared props: label, price, cta, onCta, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|eyebrow|image|imageAlt|linkLabel|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StoreCard> doesn't accept that prop. Declared props: name, price, eyebrow, image, imageAlt, linkLabel, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|links|cta|onCta|sticky|style|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: category, links, cta, onCta, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onDark|chevron|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, onDark, chevron, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
