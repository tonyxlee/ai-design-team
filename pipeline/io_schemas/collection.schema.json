{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "collection.schema.json",
  "title": "Reference Collection",
  "description": "collector → planner. 벤치마킹 레퍼런스 + 가용 디자인시스템 매핑.",
  "type": "object",
  "required": ["project_id", "design_system", "references"],
  "properties": {
    "project_id": { "type": "string" },
    "design_system": {
      "type": "object",
      "required": ["id", "projectId", "namespace"],
      "properties": {
        "id": { "type": "string", "description": "레지스트리 키" },
        "projectId": { "type": "string" },
        "namespace": { "type": "string" },
        "staged_paths": { "type": "array", "items": { "type": "string" } },
        "language_summary": { "type": "string", "description": "색·타입·스페이싱·모션 핵심 요약(readme에서 추출)" },
        "on_demand_notes": { "type": "string", "description": "온디맨드로 당겨야 할 자산(토큰 CSS/컴포넌트 prompt.md 등)" }
      }
    },
    "references": {
      "type": "array",
      "description": "반응·품질이 검증된 벤치마킹 레퍼런스",
      "items": {
        "type": "object",
        "required": ["url", "why_good", "patterns"],
        "properties": {
          "url": { "type": "string" },
          "platform": { "type": "string", "description": "web/instagram/behance/dribbble/youtube 등" },
          "signal": { "type": "string", "description": "반응 근거(좋아요·조회·수상·트래픽 등)" },
          "why_good": { "type": "string" },
          "patterns": {
            "type": "array",
            "items": { "type": "string" },
            "description": "차용 가능한 구체 연출/레이아웃/카피 패턴"
          },
          "screenshot": { "type": "string", "description": "로컬 캡처 경로(선택)" }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": { "type": "string" },
      "description": "레퍼런스 종합에서 도출한 기획 인사이트"
    },
    "template_refs": {
      "type": "array",
      "description": "template_library 캐시 히트 — planner가 1차 참조할 학습 템플릿/효과(v2)",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "description": "template_library/index.json의 entry id" },
          "kind": { "type": "string", "enum": ["component", "effect", "design-md", "mockup"] },
          "why": { "type": "string", "description": "이 프로젝트에 맞는 이유" },
          "license": { "type": "string" }
        }
      }
    },
    "source_runs": {
      "type": "array",
      "description": "소스별 수급 기록(v2) — 캐시 히트 여부와 비용 클래스를 남겨 재수급을 방지",
      "items": {
        "type": "object",
        "required": ["source", "cache_hit"],
        "properties": {
          "source": { "type": "string", "description": "tools_registry의 source id" },
          "query": { "type": "string" },
          "cache_hit": { "type": "boolean" },
          "cost_class": { "type": "string", "enum": ["free", "subscription", "credit"] },
          "items_added": { "type": "integer", "minimum": 0, "description": "template_library에 신규 적재한 수" }
        }
      }
    }
  }
}
