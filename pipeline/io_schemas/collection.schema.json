{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "collection.schema.json",
  "title": "Reference Collection",
  "description": "collector → planner. 벤치마킹 레퍼런스 + 가용 디자인시스템 매핑.",
  "type": "object",
  "required": ["project_id", "design_system", "references"],
  "properties": {
    "project_id": { "type": "string" },
    "design_system": {
      "type": "object",
      "required": ["id", "projectId", "namespace"],
      "properties": {
        "id": { "type": "string", "description": "레지스트리 키" },
        "projectId": { "type": "string" },
        "namespace": { "type": "string" },
        "staged_paths": { "type": "array", "items": { "type": "string" } },
        "language_summary": { "type": "string", "description": "색·타입·스페이싱·모션 핵심 요약(readme에서 추출)" },
        "on_demand_notes": { "type": "string", "description": "온디맨드로 당겨야 할 자산(토큰 CSS/컴포넌트 prompt.md 등)" }
      }
    },
    "references": {
      "type": "array",
      "description": "반응·품질이 검증된 벤치마킹 레퍼런스",
      "items": {
        "type": "object",
        "required": ["url", "why_good", "patterns"],
        "properties": {
          "url": { "type": "string" },
          "platform": { "type": "string", "description": "web/instagram/behance/dribbble/youtube 등" },
          "signal": { "type": "string", "description": "반응 근거(좋아요·조회·수상·트래픽 등)" },
          "why_good": { "type": "string" },
          "patterns": {
            "type": "array",
            "items": { "type": "string" },
            "description": "차용 가능한 구체 연출/레이아웃/카피 패턴"
          },
          "screenshot": { "type": "string", "description": "로컬 캡처 경로(선택)" }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": { "type": "string" },
      "description": "레퍼런스 종합에서 도출한 기획 인사이트"
    }
  }
}
