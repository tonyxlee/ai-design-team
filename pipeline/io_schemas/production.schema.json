{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "production.schema.json",
  "title": "Production Manifest",
  "description": "producer → qa. 생성된 산출물 + 자가검사 결과.",
  "type": "object",
  "required": ["project_id", "artifacts", "adherence", "tech_checks"],
  "properties": {
    "project_id": { "type": "string" },
    "design_system": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string", "description": "산출 파일 경로(workspace 기준)" },
          "type": { "type": "string", "enum": ["html", "png", "jpg", "svg", "css"] },
          "viewport": { "type": "string" },
          "screenshot": { "type": "string", "description": "검증 스크린샷 경로" }
        }
      }
    },
    "adherence": {
      "type": "object",
      "required": ["pass"],
      "properties": {
        "pass": { "type": "boolean", "description": "디자인시스템 준수 검사 통과 여부" },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": { "type": "string" },
              "where": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "tech_checks": {
      "type": "object",
      "properties": {
        "console_errors": { "type": "integer", "minimum": 0 },
        "broken_links": { "type": "array", "items": { "type": "string" } },
        "missing_assets": { "type": "array", "items": { "type": "string" } },
        "responsive_ok": { "type": "boolean" }
      }
    },
    "assets_used": {
      "type": "array",
      "description": "삽입한 에셋(v2) — asset-manifest.json의 asset id 참조",
      "items": { "type": "string" }
    },
    "imported_components": {
      "type": "array",
      "description": "외부/라이브러리에서 이식한 컴포넌트(v2)",
      "items": {
        "type": "object",
        "required": ["source", "id"],
        "properties": {
          "source": { "type": "string", "description": "tools_registry source id 또는 template-library" },
          "id": { "type": "string", "description": "컴포넌트/entry id" },
          "conversion": { "type": "string", "description": "토큰화 변환 내역(색/폰트/간격 치환 요약)" },
          "license": { "type": "string" }
        }
      }
    },
    "credits": {
      "type": "object",
      "description": "이 단계의 비용 기록(v2)",
      "properties": {
        "external_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "count": { "type": "integer" },
              "cost_class": { "type": "string", "enum": ["free", "subscription", "credit"] },
              "approved_by_orchestrator": { "type": "boolean" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
